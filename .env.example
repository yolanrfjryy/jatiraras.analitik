# ── TikTok Public Data Service ───────────────────────────────────────────────
# No authentication required — public account data only.
# Point this at your proxy / third-party endpoint when ready.
# See src/services/tiktokPublicService.js for integration instructions.
#
# Account: @jatiraras.sawarga
VITE_TIKTOK_PUBLIC_API_BASE=

# ── General ──────────────────────────────────────────────────────────────────
# How often the dashboard auto-refreshes data (milliseconds). Default: 5 min.
VITE_REFRESH_INTERVAL_MS=300000

# ── Future platform integrations ─────────────────────────────────────────────
# Instagram Graph API (coming soon)
VITE_INSTAGRAM_BASE_URL=https://graph.instagram.com

# YouTube Data API v3 (coming soon)
VITE_YOUTUBE_BASE_URL=https://www.googleapis.com/youtube/v3
